{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && (data.child('meta/hostUid').val() === auth.uid || data.child('meta/touchedAt').val() < now - 21600000)",
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['hostUid', 'gameId', 'status', 'touchedAt'])",
          "hostUid": {
            ".write": "auth != null && newData.val() === auth.uid && root.child('rooms/' + $code + '/players/' + auth.uid).exists() && root.child('rooms/' + $code + '/players/' + data.val() + '/online').val() !== true",
            ".validate": "newData.isString() && newData.parent().parent().child('players/' + newData.val()).exists()"
          },
          "gameId": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "status": { ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "touchedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
          "settings": { ".validate": true },
          "$other": { ".validate": false }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || newData.parent().parent().child('meta').exists())) || (!newData.exists() && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name', 'joinedAt', 'online'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "state": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid"
        },
        "out": {
          "$g": {
            "$uid": {
              ".write": "auth != null && !data.exists() && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid",
              ".validate": "newData.val() === true"
            }
          }
        },
        "ended": {
          "$g": {
            ".write": "auth != null && !data.exists() && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid",
            ".validate": "newData.val() === true"
          }
        },
        "done": {
          "$g": {
            "$step": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists()",
                ".validate": "newData.val() === true"
              }
            }
          }
        },
        "closed": {
          "$g": {
            "$step": {
              ".write": "auth != null && !data.exists() && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid",
              ".validate": "newData.val() === true"
            }
          }
        },
        "reveals": {
          "$g": {
            "$uid": {
              ".write": "auth != null && !data.exists() && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid && root.child('rooms/' + $code + '/out/' + $g + '/' + $uid).val() === true",
              ".validate": "newData.isString() && newData.val() === root.child('vault/' + $code + '/' + $g + '/roles/' + $uid).val()"
            }
          }
        },
        "guess": {
          "$g": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $code + '/out/' + $g + '/' + $uid).val() === true",
              ".validate": "newData.hasChildren(['text', 'key']) && newData.child('text').isString() && newData.child('text').val().length <= 40 && newData.child('key').isString() && newData.child('key').val().length <= 40"
            }
          }
        },
        "verdict": {
          "$g": {
            "$uid": {
              ".write": "auth != null && !data.exists() && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid && root.child('rooms/' + $code + '/guess/' + $g + '/' + $uid).exists()",
              ".validate": "newData.isBoolean() && newData.val() === (root.child('rooms/' + $code + '/guess/' + $g + '/' + $uid + '/key').val() === root.child('vault/' + $code + '/' + $g + '/civilKey').val())"
            }
          }
        }
      }
    },
    "secrets": {
      "$code": {
        ".write": "auth != null && !newData.exists() && !newData.parent().parent().child('rooms/' + $code).exists()",
        "$g": {
          ".write": "auth != null && !data.exists() && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "vault": {
      "$code": {
        ".write": "auth != null && !newData.exists() && !newData.parent().parent().child('rooms/' + $code).exists()",
        "$g": {
          ".read": "auth != null && root.child('rooms/' + $code + '/ended/' + $g).val() === true",
          ".write": "auth != null && !data.exists() && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid"
        }
      }
    },
    "sealed": {
      "$code": {
        ".write": "auth != null && !newData.exists() && !newData.parent().parent().child('rooms/' + $code).exists()",
        "$g": {
          "$step": {
            ".read": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid && root.child('rooms/' + $code + '/closed/' + $g + '/' + $step).val() === true",
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('rooms/' + $code + '/state/g').val() === $g && root.child('rooms/' + $code + '/state/step').val() === $step && root.child('rooms/' + $code + '/players/' + $uid).exists() && !root.child('rooms/' + $code + '/closed/' + $g + '/' + $step).exists()"
            }
          }
        }
      }
    },
    "actions": {
      "$code": {
        ".read": "auth != null && root.child('rooms/' + $code + '/meta/hostUid').val() === auth.uid",
        ".write": "auth != null && !newData.exists() && !newData.parent().parent().child('rooms/' + $code).exists()",
        "$g": {
          "$step": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('rooms/' + $code + '/state/g').val() === $g && root.child('rooms/' + $code + '/state/step').val() === $step && root.child('rooms/' + $code + '/players/' + $uid).exists()"
            }
          }
        }
      }
    }
  }
}
